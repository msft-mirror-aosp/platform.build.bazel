# Bazel tool configs
# See also build/bazel/platforms/BUILD.bazel for target-platform-specific flags.

build --host_platform='@host_platform//:host'
# info has to be overriden due to https://github.com/bazelbuild/bazel/issues/25145
info --host_platform='@platforms//host'

# These flags are necessary for bazel v9.0.0 compatibility.
# TODO(b/481315750): Fix the issues and remove these.
build --incompatible_autoload_externally=+cc_library,+cc_binary,+cc_test,+proto_library,+objc_library,+cc_proto_library

## C++
common --repo_env='BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1'
build --incompatible_enable_cc_toolchain_resolution
build --host_features='-thin_lto'

## Rust
# See https://bazelbuild.github.io/rules_rust/rust_settings.html#experimental_use_allocator_libraries_with_mangled_symbols
# Used to handle new allocator symbol mangling
build  --@rules_rust//rust/settings:experimental_use_allocator_libraries_with_mangled_symbols

# Allow unstable features for target code
build --@rules_rust//rust/settings:extra_rustc_env=RUSTC_BOOTSTRAP=1

# Allow unstable features for build tools (e.g. allocator libraries, etc)
build --@rules_rust//rust/settings:extra_exec_rustc_env=RUSTC_BOOTSTRAP=1

## Protobuf
build --proto_compiler=@protobuf//:protoc
build --proto_toolchain_for_cc=@protobuf//:cc_toolchain
# Use prebuilt protoc to save some build time.
# This currently causes failures with GRPC on Windows.
build:linux --@protobuf//bazel/toolchains:prefer_prebuilt_protoc
build:macos --@protobuf//bazel/toolchains:prefer_prebuilt_protoc

## Python
build --@rules_python//python/config_settings:bootstrap_impl=script
# On Windows the launch_emulator zip does not correctly support symlinks needed
# by to make the launcher directory work correctly.
build:windows --@rules_python//python/config_settings:build_python_zip=false

# Default clang tidy config, use --config clang-tidy
build:clang-tidy --aspects @goldfish_build//rules:clang_tidy.bzl%clang_tidy_aspect
build:clang-tidy --output_groups=tidy_fixes
build:clang-tidy "--@goldfish_build//:clang_tidy_config=@goldfish//:clang_tidy_config"
build:clang-tidy "--@goldfish_build//:clang_tidy_regex=s/m_//g"

# Always enable debug info and symbols on linux and macos.
build:macos --features='generate_debug_symbols'
build:linux --features='generate_debug_symbols'

