# Bazel-wide general configs
common --enable_platform_specific_config
common --downloader_config=build/bazel/utils/downloader.cfg

# Note that file:/// needs 3 / to work with %workspace% on Windows.
common --registry=file:///%workspace%/build/bazel/registry
common --registry=https://bcr.bazel.build

# See https://docs.aspect.build/guides/bazelrc/
# Docs: https://bazel.build/reference/command-line-reference#flag--incompatible_strict_action_env
build --incompatible_strict_action_env
build --nolegacy_external_runfiles

# Hardened sandboxes
build --nosandbox_default_allow_network
build --sandbox_fake_hostname
build --sandbox_fake_username

# Qemu is resource intensive and causes timeouts if concurrency is too high.
# Consume this resource to limit local parallelism for tests booting qemu:
# tags = ["resources:qemu_instances:1"],
build --local_resources=qemu_instances=1

# Enable windows symlink and runfiles
startup --windows_enable_symlinks
build:windows --enable_runfiles

# Custom workspace commands
build:linux --workspace_status_command="prebuilts/python/linux-x86/bin/python3 build/bazel/utils/bazel_workspace.py"
build:macos --workspace_status_command="prebuilts/python/darwin-x86/bin/python3 build/bazel/utils/bazel_workspace.py"
build:windows --workspace_status_command="build\\bazel\\utils\\bazel_workspace.cmd"

# Credential helper for GCE access
common:linux --credential_helper="*.googleapis.com=%workspace%/build/bazel/utils/credential_helper.sh"
common:macos --credential_helper="*.googleapis.com=%workspace%/build/bazel/utils/credential_helper.sh"
common:windows --credential_helper="*.googleapis.com=%workspace%/build/bazel/utils/credential_helper.cmd"

# googlesource
common:linux --credential_helper="*.googlesource.com=%workspace%/build/bazel/utils/credential_helper.sh"
common:macos --credential_helper="*.googlesource.com=%workspace%/build/bazel/utils/credential_helper.sh"
common:windows --credential_helper="*.googlesource.com=%workspace%/build/bazel/utils/credential_helper.cmd"

# Airlock
common:linux --credential_helper="*.pkg.dev=%workspace%/build/bazel/utils/credential_helper.sh"
common:macos --credential_helper="*.pkg.dev=%workspace%/build/bazel/utils/credential_helper.sh"
common:windows --credential_helper="*.pkg.dev=%workspace%/build/bazel/utils/credential_helper.cmd"

# Publish to the private BES backend.
build:sponge --grpc_keepalive_time=30s
build:sponge --bes_keywords=android-emulator
build:sponge --bes_backend=buildeventservice-pa.googleapis.com
build:sponge --bes_results_url=https://fusion2.corp.google.com/invocations/
build:sponge --bes_timeout=240s
build:sponge --build_event_upload_max_retries=5
build:sponge --legacy_important_outputs

build:no_sponge --bes_backend=
build:no_sponge --bes_results_url=

# Enable go/antswatcher to process test results.
# This config must be used with the sponge config as it relies on the same bes_backend.
# NOTE: Bazel invocations must still supply --build_metadata values for test_definition_name
build:ants --bes_keywords="android-test-storage"
build:ants --bes_keywords="antswatcher:skip_tests_if_timeout"
build:ants --build_metadata="generate_test_uri=fusion"
build:ants --build_metadata="run_type=critical"

# Base RBE configuration
build:_remote_base --grpc_keepalive_time=30s
build:_remote_base --remote_cache=grpcs://remotebuildexecution.googleapis.com
build:_remote_base --remote_instance_name=projects/emulator-builds/instances/default_instance
build:_remote_base --jobs=100
# remote_local_fallback allows bazel to continue if there are
# network connectivity failures (e.g., offline)
build:_remote_base --remote_local_fallback

# Config to use hermetic SDKs
build:hermetic --@goldfish_build//toolchains/cc/mac_clang:hermetic_xcode
build:hermetic --@goldfish_build//toolchains/cc/windows_clang:hermetic_msvc
build:hermetic --repo_env=CC_ALLOW_HOST_SDK=0

# Java config
build --java_language_version=17
build --java_runtime_version=jdk17

# Configs for local builds with remote cache in read-only.
# This avoids re-running cached actions.
build:rcache --config=_remote_base
build:rcache --noremote_upload_local_results

# Configs for local builds with all online features
build:connected --config=rcache
build:connected --config=hermetic
build:connected --config=sponge

# Configs for remote builds with RBE
build:remote --config=_remote_base
build:remote --remote_executor=grpcs://remotebuildexecution.googleapis.com
build:remote --remote_timeout=3600
build:remote --show_timestamps
build:remote --jobs=200

# Configs to run certain actions dynamically
# Used when big action running on RBE is the main bottleneck while local
# resources are available.
build:dynamic --config=remote
build:dynamic --internal_spawn_scheduler
build:dynamic --strategy=CppLink=dynamic
build:dynamic --strategy=SymbolZip=dynamic
build:dynamic --strategy=PackageZip=local
build:dynamic --strategy=PythonZipper=dynamic
build:dynamic --strategy=Strip=dynamic
build:dynamic --strategy=GnuDebugInfo=dynamic
build:dynamic --strategy=ExtractBreakpadSymbols=dynamic

# Configs for CI builds
# When running CI, fail the build if the lockfile needs update
startup:ci --experimental_remote_repo_contents_cache
common:ci --lockfile_mode=error
common:ci --remote_build_event_upload=all
common:ci --experimental_collect_system_network_usage
build:ci --config=_remote_base
build:ci --config=sponge
build:ci --config=hermetic
# When targets are all cached the BES upload may take a long time.
build:ci --bes_timeout=600s
build:ci --experimental_enable_execution_graph_log
build:ci --experimental_execution_graph_log_dep_type=all

# Reduce log spam
build:ci --ui_event_filters=-info
build:ci --ui_event_filters=-debug
build:ci --noshow_progress
build:ci --noshow_loading_progress


# RBE-based cross-platform and multi-platform build configurations
# Experimental and best-effort support only; NOT tested in CI builds.
## (Any) -> Windows x64
build:rbe-win-x64 --config=hermetic --config=remote --remote_local_fallback=false
build:rbe-win-x64 --platforms=@goldfish_build//platforms:windows_x64
build:rbe-win-x64 --extra_execution_platforms=@goldfish_build//platforms:windows_x64
build:rbe-win-x64 --remote_upload_local_results=false

## (Any) -> Linux x64
build:rbe-linux-x64 --config=remote --remote_local_fallback=false
build:rbe-linux-x64 --platforms=@goldfish_build//platforms:linux_x64
build:rbe-linux-x64 --extra_execution_platforms=@goldfish_build//platforms:linux_x64
build:rbe-linux-x64 --remote_upload_local_results=false

## (Any) -> Linux aarch64 (cross-compiled on linux x64)
build:rbe-linux-aarch64 --config=remote --remote_local_fallback=false
build:rbe-linux-aarch64 --platforms=@goldfish_build//platforms:linux_aarch64
build:rbe-linux-aarch64 --extra_execution_platforms=@goldfish_build//platforms:linux_x64
build:rbe-linux-aarch64 --remote_upload_local_results=false

common:aosp --repo_env=MULTISOURCE_REPO_TYPE=aosp
common:aosp --downloader_config=build/bazel/utils/downloader_aosp.cfg
