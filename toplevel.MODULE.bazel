"""The android emulator."""

module(
    name = "android_emulator",
    version = "0.0.1",
)

include("//build/bazel/toolchains:toolchain.MODULE.bazel")

custom_toolchains = use_extension("@goldfish_build//extensions:toolchain.bzl", "toolchain")
custom_toolchains.clang(root_path = "prebuilts/clang/host")
custom_toolchains.java(
    root_path = "prebuilts/studio/jdk",
    version = "jdk17",
)
use_repo(custom_toolchains, "gcc_lib")

bazel_dep(name = "goldfish", version = "0.0.1")
bazel_dep(name = "gfxstream", version = "0.0.1")
bazel_dep(name = "qemu", version = "0.0.1")
bazel_dep(name = "breakpad", version = "0.0.1")
bazel_dep(name = "pkg-config", version = "0.29.2")
bazel_dep(name = "ninja", version = "1.12.1.bcr.1")
bazel_dep(name = "boringssl", version = "0.20251124.0")
bazel_dep(name = "abseil-cpp", version = "20260526.0")
bazel_dep(name = "tink_cc", version = "2.7.0")

# repo_name override needed by @grpc
bazel_dep(name = "protoc-gen-validate", version = "1.3.0", repo_name = "com_envoyproxy_protoc_gen_validate")

# Dep of GRPC but override here
# Use local registry version to address https://github.com/bazelbuild/bazel/issues/26922
bazel_dep(name = "c-ares", version = "1.34.6")
bazel_dep(name = "grpc-java", version = "1.82.0")
bazel_dep(name = "grpc", version = "1.81.1.aemu")

# These are only needed for AMC
# TODO(whollins): get them from @qemu module instead somehow
bazel_dep(name = "zlib", version = "1.3.2")
bazel_dep(name = "pcre2", version = "10.46-DEV")
bazel_dep(name = "glib", version = "2.82.2.bcr.5.aemu")
bazel_dep(name = "dtc", version = "0.0.1")
bazel_dep(name = "pixman", version = "0.0.1")
bazel_dep(name = "aemu", version = "0.0.2")
bazel_dep(name = "rutabaga_gfx", version = "0.0.1")
bazel_dep(name = "libpng", version = "0.0.1")
bazel_dep(name = "pffft", version = "1.1.0")
bazel_dep(name = "rnnoise", version = "0.2.0")
bazel_dep(name = "libgav1", version = "0.20.0")
bazel_dep(name = "dav1d", version = "1.5.3-58-g14c73c7d")
bazel_dep(name = "libsrtp2", version = "2.3.0")
bazel_dep(name = "libyuv", version = "1948")
bazel_dep(name = "nasm", version = "2.16.03.bcr.3")
bazel_dep(name = "rules_nasm", version = "0.5.0")

register_toolchains("//build/bazel/toolchains:nasm_toolchain")

# These are all deps of lavapipe?
bazel_dep(name = "libdrm", version = "2.4.110")
bazel_dep(name = "libexpat", version = "2.7.1.aemu")
bazel_dep(name = "libffi", version = "3.4.7.bcr.3.aemu")
bazel_dep(name = "libjpeg_turbo", version = "2.1.91")
bazel_dep(name = "libx11", version = "1.8.12.bcr.3.aemu")
bazel_dep(name = "libxext", version = "1.3.6")
bazel_dep(name = "libxrandr", version = "1.5.4")
bazel_dep(name = "libxshmfence", version = "1.3.3")
bazel_dep(name = "xorgproto", version = "2024.1.bcr.1")
bazel_dep(name = "libxcb", version = "1.17.0.bcr.2.aemu")
bazel_dep(name = "wayland", version = "1.22.0")
bazel_dep(name = "qt_prebuilt", version = "6.5.3")
local_path_override(
    module_name = "qt_prebuilt",
    path = "prebuilts/android-emulator-build/qt",
)

include("//build/bazel:vendor.MODULE.bazel")

# rules_android is imported by toolchain.MODULE.bazel
android_sdk_repository_extension = use_extension("@rules_android//rules/android_sdk_repository:rule.bzl", "android_sdk_repository_extension")
android_sdk_repository_extension.configure(paths = {
    "linux": "$WORKSPACE_ROOT/prebuilts/android/android-sdk/linux",
    "macos": "$WORKSPACE_ROOT/prebuilts/android/android-sdk/macosx",
    "windows": "$WORKSPACE_ROOT/prebuilts/android/android-sdk/windows",
})

# Enable Java gRPC compilation
bazel_dep(name = "rules_jvm_external", version = "6.10")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
use_repo(maven, "maven")

maven.artifact(
    testonly = True,
    artifact = "runner",
    group = "androidx.test",
    version = "1.7.0",
)
maven.install(
    artifacts = [
        # Rerun REPIN=1 bazel run @maven//:pin, and update
        # the lock_file if you change this list.
        "com.google.api.grpc:grpc-google-cloud-pubsub-v1:1.125.0",
        "com.google.api.grpc:proto-google-cloud-pubsub-v1:1.125.0",
        "com.squareup.okhttp:okhttp:2.7.5",
        "com.squareup.okio:okio:2.10.0",
        "io.grpc:grpc-okhttp:1.82.0",
        "io.grpc:grpc-core:1.82.0",
        "io.grpc:grpc-android:1.82.0",
        "io.grpc:grpc-stub:1.82.0",
        "io.grpc:grpc-protobuf:1.82.0",
        "io.grpc:grpc-protobuf-lite:1.82.0",
        "androidx.test:core:1.7.0",
        "androidx.test:rules:1.7.0",
    ],
    lock_file = "@goldfish_build//:maven_install.json",
    repositories = [
        "https://repo.maven.apache.org/maven2/",
        "https://maven.google.com",
    ],
    strict_visibility = True,
    version_conflict_policy = "pinned",
)

bazel_dep(name = "lavapipe_bazel_deps", version = "0.0.1")
local_path_override(
    module_name = "lavapipe_bazel_deps",
    path = "prebuilts/android-emulator-build/common/vulkan/linux-x86_64/lavapipe-bazel-deps",
)

bazel_dep(name = "mesa3d", version = "0.0.1")
bazel_dep(name = "wayland-protocols", version = "1.41")
bazel_dep(name = "webrtc", version = "152.0.0.aemu")
