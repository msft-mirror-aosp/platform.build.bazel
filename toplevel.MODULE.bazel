"""The android emulator."""

module(
    name = "android_emulator",
    version = "0.0.1",
)

include("//build/bazel/toolchains:toolchain.MODULE.bazel")

bazel_dep(name = "lz4", version = "1.9.4")
bazel_dep(name = "zlib", version = "1.3.1.bcr.5")
bazel_dep(name = "protobuf", version = "32.1")

# repo_name override needed by @grpc
bazel_dep(name = "protoc-gen-validate", version = "1.2.1.bcr.1", repo_name = "com_envoyproxy_protoc_gen_validate")
bazel_dep(name = "boringssl", version = "0.20250415.0")
bazel_dep(name = "tink_cc", version = "2.4.0")

# Dep of GRPC but override here
# Use local registry version to address https://github.com/bazelbuild/bazel/issues/26922
bazel_dep(name = "c-ares", version = "1.19.1.aemu")
bazel_dep(name = "grpc-java", version = "1.75.0")
bazel_dep(name = "grpc", version = "1.74.1")
single_version_override(
    module_name = "grpc",
    patch_strip = 1,
    patches = [
        "//build/bazel/patch:grpc-no-macos-universal-binary.patch",
        "//build/bazel/patch:grpc_remove_upb-gen.patch",
    ],
)

bazel_dep(name = "abseil-cpp", version = "20250512.1")
bazel_dep(name = "googletest", version = "1.17.0")
bazel_dep(name = "google_benchmark", version = "1.9.4")
bazel_dep(name = "re2", version = "2024-07-02.bcr.1")
bazel_dep(name = "libjpeg_turbo", version = "2.1.91")
bazel_dep(name = "tinyobjloader", version = "2.0.0-rc1.bcr.1")
bazel_dep(name = "pcre2", version = "10.46-DEV")
bazel_dep(name = "glib", version = "2.82.2.bcr.5")
single_version_override(
    module_name = "glib",
    patch_strip = 1,
    patches = [
        "//build/bazel/patch:glib-patches-for-AEMU.patch",
    ],
)

bazel_dep(name = "aemu", version = "0.0.1")
local_path_override(
    module_name = "aemu",
    path = "hardware/google/aemu",
)

bazel_dep(name = "qt_prebuilt", version = "6.5.3")
local_path_override(
    module_name = "qt_prebuilt",
    path = "prebuilts/android-emulator-build/qt",
)

# Needed by CrosVM
bazel_dep(name = "gfxstream", version = "0.0.1")
local_path_override(
    module_name = "gfxstream",
    path = "hardware/google/gfxstream",
)

# Needed by Qemu
bazel_dep(name = "dtc", version = "0.0.1")
local_path_override(
    module_name = "dtc",
    path = "third_party/dtc",
)

bazel_dep(name = "webrtc", version = "0.0.1")
local_path_override(
    module_name = "webrtc",
    path = "third_party/webrtc",
)

bazel_dep(name = "aemu-grpc", version = "0.0.1")
local_path_override(
    module_name = "aemu-grpc",
    path = "third_party/adt-infra/pytest/aemu_grpc",
)

bazel_dep(name = "libuv", version = "1.48.0")
single_version_override(
    module_name = "libuv",
    patch_strip = 1,
    patches = [
        "//build/bazel/patch:libuv-windows-support.patch",
    ],
)

bazel_dep(name = "goldfish_crates", version = "0.0.1")

local_rust_crates = use_extension("@goldfish_crates//:local_rust_crates.bzl", "local_rust_crates")
use_repo(local_rust_crates, "aead", "aes", "aho-corasick", "android_log-sys", "anstyle", "anyhow", "argh", "argh_derive", "argh_shared", "arrayvec", "base64", "bitflags", "byteorder", "bytes", "ccm", "cfg-if", "chrono", "cipher", "clap", "clap_builder", "clap_derive", "clap_lex", "codespan-reporting", "cpufeatures", "crc32fast", "crossbeam-utils", "crypto-common", "ctr", "data-encoding", "env_logger", "equivalent", "etherparse", "flate2", "fnv", "foldhash", "futures", "futures-channel", "futures-core", "futures-executor", "futures-io", "futures-macro", "futures-sink", "futures-task", "futures-util", "generic-array", "getrandom", "glam", "grpcio", "grpcio-sys", "hashbrown", "heck", "hex", "http", "httparse", "inout", "itoa", "libc", "libz-rs-sys", "libz-sys", "lock_api", "log", "memchr", "memoffset", "mio", "nix", "num-bigint", "num-derive", "num-integer", "num-traits", "num_cpus", "once_cell", "parking_lot", "parking_lot_core", "pdl-compiler", "pdl-runtime", "pest", "pest_derive", "pest_generator", "pest_meta", "pica", "pin-project-lite", "pin-utils", "ppv-lite86", "prettyplease", "proc-macro2", "protobuf-json-mapping", "protobuf-rust", "protobuf-support", "quote", "rand", "rand_chacha", "rand_core", "regex", "regex-automata", "regex-syntax", "remain", "ryu", "scopeguard", "serde", "serde_derive", "serde_json", "signal-hook-registry", "slab", "smallvec", "socket2", "strsim", "subtle", "syn", "termcolor", "thiserror", "thiserror-impl", "tokio", "tokio-macros", "tokio-stream", "tokio-util", "tungstenite", "typenum", "ucd-trie", "unicode-ident", "unicode-width", "utf-8", "winapi", "winapi-x86_64-pc-windows-gnu", "windows-sys", "windows-targets", "windows_aarch64_gnullvm", "windows_i686_gnullvm", "windows_x86_64_gnullvm", "zerocopy", "zerocopy-derive", "zip", "zlib-rs")

# Non-module repositories

local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")

new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Needed by Qemu
new_local_repository(
    name = "crosvm",
    build_file = "//hardware/generic/goldfish/third_party/crosvm:BUILD.crosvm",
    path = "third_party/crosvm",
)

local_repository(
    name = "perfetto",
    path = "third_party/perfetto",
)

local_repository(
    name = "perfetto_cfg",
    path = "build/bazel/perfetto_overrides",
)

local_repository(
    name = "rnnoise",
    path = "third_party/rnnoise",
)

local_repository(
    name = "com_google_breakpad",
    path = "third_party/google-breakpad",
)

local_repository(
    name = "com_google_crashpad",
    path = "third_party/crashpad",
)

local_repository(
    name = "pffft",
    path = "third_party/pffft",
)

local_repository(
    name = "libvpx",
    path = "third_party/libvpx",
)

local_repository(
    name = "libyuv",
    path = "third_party/libyuv",
)

# Needed by Qemu
local_repository(
    name = "pixman",
    path = "third_party/pixman",
)

http_archive(
    name = "wycheproof",
    sha256 = "eb1d558071acf1aa6d677d7f1cabec2328d1cf8381496c17185bd92b52ce7545",
    strip_prefix = "wycheproof-d8ed1ba95ac4c551db67f410c06131c3bc00a97c",
    url = "https://github.com/google/wycheproof/archive/d8ed1ba95ac4c551db67f410c06131c3bc00a97c.zip",
)

system_image_ext = use_extension("//hardware/generic/goldfish/emulator/sdk/system_images:sysimage.bzl", "system_image_extension")
system_image_ext.image(
    name = "android_36_playstore_x64",
    abi = "x86_64",
    api = "36",
    rev = "6",
    tag = "google_apis_playstore",
)
system_image_ext.image(
    name = "android_36_playstore_arm64",
    abi = "arm64-v8a",
    api = "36",
    rev = "6",
    tag = "google_apis_playstore",
)
use_repo(system_image_ext, "android_36_playstore_arm64", "android_36_playstore_x64")

gcs_archive = use_repo_rule("@rules_gcs//gcs:repo_rules.bzl", "gcs_archive")

gcs_archive(
    name = "android_minigbm-x86_64",
    build_file = "//hardware/generic/goldfish/emulator/sdk/system_images/minigbm-x86_64:minigbm.BUILD",
    sha256 = "815498cb6ccecf13bcb73f2818c4e3a82d77d4ada914ee468338b82cf5cb07a4",
    url = "gs://emu-next-bazel/sys-img/sdk_gphone64_x86_64_minigbm-userdebug/sdk-repo-linux-system-images-13585903.zip",
)

gcs_archive(
    name = "android_minigbm-arm64-v8a",
    build_file = "//hardware/generic/goldfish/emulator/sdk/system_images/minigbm-arm64-v8a:minigbm.BUILD",
    sha256 = "020e867aa29487554b43df52af8625b31f0081d7ac8aafb8b1efdb8558c50a42",
    url = "gs://emu-next-bazel/sys-img/sdk_gphone64_arm64_minigbm-userdebug/sdk-repo-linux-system-images-13585903.zip",
)
