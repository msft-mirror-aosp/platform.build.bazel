import %workspace%/build/bazel/base.bazelrc
import %workspace%/build/bazel/tool.bazelrc

build --define grpc_no_xds=true
build --define GRPC_ALLOW_EXCEPTIONS=0

# gtest uses this to build against ABSL
build --define absl=1

# Fast mode libc++ hardening
build --copt=-D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_FAST
build --host_copt=-D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_FAST


build:debug --compilation_mode=dbg --strip=never
build:release --compilation_mode=opt
build:release-assert --config=release --copt=-UNDEBUG
build:debug_symbols --features='generate_debug_symbols'
build:lto --config=release --features='thin_lto'

build:asan --features='asan'
# ASAN hits ODR violations with shared linkage due to rules_proto.
build:asan --dynamic_mode=off
build:msan --features='msan'
build:tsan --features='tsan'

build:citsan --config=ci
build:citsan --config=debug
build:citsan --config=tsan

build:ciasan --config=ci
build:ciasan --config=debug
build:ciasan --config=asan

# Clang-tidy execution configuration
build:tidy --@aemu//tools/clang_tidy:clang_tidy_enabled=true
test:tidy --@aemu//tools/clang_tidy:clang_tidy_enabled=true

# Code coverage configuration (LLVM source-based coverage)
coverage --build_tests_only
coverage --test_tag_filters=-tidy-test
coverage --combined_report=lcov
coverage --experimental_use_llvm_covmap
coverage --experimental_generate_llvm_lcov
coverage --instrumentation_filter=//emulator[/:],@goldfish//emulator[/:],//common[/:],//host[/:]

# Gfxstream software GLES (ANGLE) and Vulkan (Lavapipe) test environment (Linux and macOS).
build:linux --@gfxstream//common/testenv:graphics_test_environment=gles_angle_vulkan_lavapipe
build:linux --@gfxstream//common/testenv:gles_angle_drivers=@goldfish_prebuilts_common//ANGLE:lib_linux_x86_64
build:linux --@gfxstream//common/testenv:vulkan_lavapipe_drivers=@goldfish//emulator/libs/ver:test_vulkan_icds
build:macos --@gfxstream//common/testenv:graphics_test_environment=gles_angle_vulkan_lavapipe
build:macos --@gfxstream//common/testenv:gles_angle_drivers=@goldfish_prebuilts_common//ANGLE:lib_darwin_aarch64
build:macos --@gfxstream//common/testenv:vulkan_lavapipe_drivers=@goldfish//emulator/libs/ver:test_vulkan_icds

# User overrides must come last
try-import %workspace%/user.bazelrc
