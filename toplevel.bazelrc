import %workspace%/build/bazel/base.bazelrc
import %workspace%/build/bazel/tool.bazelrc

#common --announce_rc
common --credential_helper=storage.googleapis.com=%workspace%/build/bazel/utils/credential_helper.sh

build --define grpc_no_xds=true

build:macos --xcode_version_config //build/bazel/toolchains/cc/mac_clang:host_xcodes
build:macos --xcode_version=16.2

#build --//build/bazel/toolchains/cc/mac_clang:hermetic_xcode=false

build:debug --compilation_mode=dbg --strip=never --copt=-fno-limit-debug-info
build:release --compilation_mode=opt
build:release-assert --config=release --copt=-UNDEBUG

build:asan --features='asan'
# ASAN hits ODR violations with shared linkage due to rules_proto.
build:asan --dynamic_mode=off
build:msan --features='msan'
build:tsan --features='tsan'
