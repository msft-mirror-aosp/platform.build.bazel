load("@bazel_skylib//lib:dicts.bzl", "dicts")
load(
    "@bazel_toolchains//rules/exec_properties:exec_properties.bzl",
    "create_rbe_exec_properties_dict",
)

package(default_visibility = ["//visibility:public"])

# cache-silo-key: this is essentially a "salt" added to the remote cache key.
# Change it to a new value when we want to create a new cache from scratch.
EXEC_PROPERTIES = {"cache-silo-key": "20240813"}

platform(
    name = "linux_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@bazel_tools//tools/cpp:clang",
    ],
    exec_properties = dicts.add(
        EXEC_PROPERTIES,
        create_rbe_exec_properties_dict(
            container_image = "docker://us-central1-docker.pkg.dev/kokoro-container-bakery/android-devtools/emulator-linux@sha256:917a4c96fef65b71e59d028ffeda809b161f5d320bf21c96cb8191414273e1c9",
            docker_add_capabilities = "SYS_NICE",
            docker_network = "off",
            docker_privileged = True,  # This is required to support emulators/nested KVM.
            docker_use_urandom = True,
            labels = {
                "machine-size": "default",
                "image-family": "linux-default",
                "has-virtualization": "true",
            },
            os_family = "Linux",
        ),
    ),
)

platform(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "@bazel_tools//tools/cpp:clang",
    ],
    exec_properties = EXEC_PROPERTIES,
)

platform(
    name = "macos_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:macos",
        "@bazel_tools//tools/cpp:clang",
    ],
    exec_properties = EXEC_PROPERTIES,
)

platform(
    name = "macos_aarch64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
        "@bazel_tools//tools/cpp:clang",
    ],
    exec_properties = EXEC_PROPERTIES,
)

platform(
    name = "windows_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@bazel_tools//tools/cpp:clang-cl",
    ],
    exec_properties = dicts.add(
        EXEC_PROPERTIES,
        create_rbe_exec_properties_dict(
            container_image = "docker://us-central1-docker.pkg.dev/kokoro-container-bakery/android-devtools/emulator-windows@sha256:6c951ac07a9f18f1f4b8da6b9eab20d1c19a4b400dca1a5fe4919f7366050aa1",
            docker_network = "off",
            labels = {
                "machine-size": "default",
                "image-family": "windows-2022",
                "has-virtualization": "false",
            },
            os_family = "Windows",
        ),
    ),
)
