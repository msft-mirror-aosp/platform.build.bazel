load("@bazel_skylib//lib:dicts.bzl", "dicts")
load(
    "@bazel_toolchains//rules/exec_properties:exec_properties.bzl",
    "create_rbe_exec_properties_dict",
)

package(default_visibility = ["//visibility:public"])

# cache-silo-key: this is essentially a "salt" added to the remote cache key.
# Change it to a new value when we want to create a new cache from scratch.
EXEC_PROPERTIES = {"cache-silo-key": "20240813"}

platform(
    name = "linux_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@bazel_tools//tools/cpp:clang",
    ],
    exec_properties = dicts.add(
        EXEC_PROPERTIES,
        create_rbe_exec_properties_dict(
            container_image = "docker://us-central1-docker.pkg.dev/kokoro-container-bakery/android-devtools/emulator-linux@sha256:7eb603c6ea0f20e7477230253ef093ce6779f1419d660feae082041f83e1d97f",
            docker_add_capabilities = "SYS_NICE",
            docker_network = "off",
            docker_privileged = True,  # This is required to support emulators/nested KVM.
            docker_use_urandom = True,
            labels = {
                "machine-size": "default",
                "image-family": "linux-default",
                "has-virtualization": "true",
            },
            os_family = "Linux",
        ),
    ),
)

platform(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "@bazel_tools//tools/cpp:clang",
    ],
    exec_properties = EXEC_PROPERTIES,
)

platform(
    name = "macos_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:macos",
        "@bazel_tools//tools/cpp:clang",
    ],
    exec_properties = EXEC_PROPERTIES,
)

platform(
    name = "macos_aarch64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
        "@bazel_tools//tools/cpp:clang",
    ],
    exec_properties = EXEC_PROPERTIES,
)

platform(
    name = "windows_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@bazel_tools//tools/cpp:clang-cl",
    ],
    exec_properties = dicts.add(
        EXEC_PROPERTIES,
        create_rbe_exec_properties_dict(
            container_image = "docker://us-central1-docker.pkg.dev/google.com/android-studio-alphasource/rbe/windows-2022-test@sha256:eaa19f67a1b92739a3d87e64bfa005bbedcbd217869efdd8c08d4070ac0ab52a",
            docker_network = "off",
            labels = {
                "machine-size": "default",
                "image-family": "2022",
            },
            os_family = "Windows",
        ),
    ),
)
