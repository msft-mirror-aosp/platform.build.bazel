load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "bool_setting")
load(":bootstrap.bzl", "cc_bootstrap_binary")

filegroup(
    name = "empty",
    srcs = [],
    visibility = ["@toolchain_hub//:__subpackages__"],
)

bool_setting(
    name = "bootstrap",
    build_setting_default = False,
)

config_setting(
    name = "is_bootstrap",
    flag_values = {
        ":bootstrap": "true",
    },
    visibility = ["//visibility:public"],
)

cc_bootstrap_binary(
    name = "wrapper",
    srcs = ["wrapper.cc"],
    visibility = ["//visibility:public"],
)

toolchain_type(
    name = "objcopy_toolchain_type",
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "allow_strip",
    build_setting_default = False,
)
