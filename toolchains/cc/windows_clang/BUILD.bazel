load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

package(default_visibility = ["//visibility:public"])

bool_flag(
    name = "hermetic_msvc",
    build_setting_default = False,
    scope = "universal",
)

toolchain_type(
    name = "resource_compiler_toolchain_type",
    visibility = ["//visibility:public"],
)

alias(
    name = "msdia",
    actual = "@toolchain_hub//cc/windows_clang:msdia",
)

filegroup(
    name = "sysroot_x64",
    srcs = [
        "@toolchain_hub//cc/windows_clang:msvc_runtimes_x64",
        "@toolchain_hub//cc/windows_clang:sdk_libs_x64",
    ],
)

filegroup(
    name = "sysroot_aarch64",
    srcs = [
        "@toolchain_hub//cc/windows_clang:msvc_runtimes_aarch64",
        "@toolchain_hub//cc/windows_clang:sdk_libs_aarch64",
    ],
)
