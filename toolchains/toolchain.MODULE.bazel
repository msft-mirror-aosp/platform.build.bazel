"""Toolchain dependencies and repos."""

# TODO This needs a better way to stay in sync with @goldfish_build
TOOL_VERSIONS = {
    "rust": "1.85.1",
}

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.8.1")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_gcs", version = "1.0.1")
bazel_dep(name = "rules_cc", version = "0.2.3")
bazel_dep(name = "rules_python", version = "1.6.3")
bazel_dep(name = "rules_shell", version = "0.5.1")
bazel_dep(name = "rules_go", version = "0.51.0-rc2")
bazel_dep(name = "rules_java", version = "8.11.0")
bazel_dep(name = "rules_kotlin", version = "2.1.6")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_rust", version = "0.64.0")
bazel_dep(name = "with_cfg.bzl", version = "0.10.1")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.10",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    versions = [TOOL_VERSIONS["rust"]],
)

bazel_dep(name = "buildifier_prebuilt", version = "8.0.3", dev_dependency = True)

register_toolchains(
    "@goldfish_build//toolchains/cc/linux_clang:x64_toolchain",
    "@goldfish_build//toolchains/cc/linux_clang:x64_objcopy_toolchain",
    "@goldfish_build//toolchains/cc/mac_clang:x64_toolchain",
    "@goldfish_build//toolchains/cc/mac_clang:arm64_toolchain",
    "@goldfish_build//toolchains/cc/mac_clang:objcopy_toolchain",
    "@goldfish_build//toolchains/cc/windows_clang:x64_toolchain",
    "@goldfish_build//toolchains/cc/windows_clang:resource_compiler_x64",
    "@goldfish_build//toolchains/cc/mac_clang:mig_toolchain",
)

register_toolchains(
    "@goldfish_build//toolchains/rust:rust_linux_x64_toolchain",
)

host_platform_repository = use_repo_rule("@goldfish_build//platforms:host_platform.bzl", "host_platform_repository")

host_platform_repository(
    name = "host_platform",
    host = {
        '{"os": "linux", "arch": "x64"}': "@goldfish_build//platforms:linux_x64",
        '{"os": "macos", "arch": "x64"}': "@goldfish_build//platforms:macos_x64",
        '{"os": "macos", "arch": "arm64"}': "@goldfish_build//platforms:macos_aarch64",
        '{"os": "windows", "arch": "x64"}': "@goldfish_build//platforms:windows_x64",
    },
)

# Unfortunately, java_test seems to assume that if the toolchain is not in root
# repository then it is at the root of the dependency so we can't use
# @goldfish_prebuilts directly.
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

new_local_repository(
    name = "linux_jdk17",
    build_file = "@goldfish_build//toolchains/java:linux_jdk.BUILD",
    path = "prebuilts/studio/jdk/jdk17/linux",
)

new_local_repository(
    name = "mac_jdk17",
    build_file = "@goldfish_build//toolchains/java:mac_jdk.BUILD",
    path = "prebuilts/studio/jdk/jdk17/mac-arm64/Contents/Home",
)

new_local_repository(
    name = "windows_jdk17",
    build_file = "@goldfish_build//toolchains/java:windows_jdk.BUILD",
    path = "prebuilts/studio/jdk/jdk17/win",
)

# Java toolchains
register_toolchains(
    "@linux_jdk17//:all",
    "@mac_jdk17//:all",
    "@windows_jdk17//:all",
)
