"""Toolchain dependencies and repos."""

# Keep this version in sync with "tool_versions.json"
TOOL_VERSIONS = {
    "clang": "clang-r563880",
    "rust": "1.91.1",
}

bazel_dep(name = "goldfish_build", version = "0.0.3")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.8.1")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_gcs", version = "1.0.1")
bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "rules_python", version = "1.6.3")
bazel_dep(name = "rules_shell", version = "0.5.1")
bazel_dep(name = "rules_go", version = "0.51.0-rc2")
bazel_dep(name = "rules_java", version = "8.11.0")
bazel_dep(name = "rules_kotlin", version = "2.1.6")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_rust", version = "0.67.0")
bazel_dep(name = "with_cfg.bzl", version = "0.10.1")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.10",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    versions = [TOOL_VERSIONS["rust"]],
)

custom_toolchains = use_extension("@goldfish_build//extensions:toolchain.bzl", "toolchain")
custom_toolchains.version_file(
    label = "@goldfish_build//toolchains:tool_versions.json",
)

bazel_dep(name = "buildifier_prebuilt", version = "8.0.3", dev_dependency = True)

host_platform_repository = use_repo_rule("@goldfish_build//platforms:host_platform.bzl", "host_platform_repository")

host_platform_repository(
    name = "host_platform",
    host = {
        '{"os": "linux", "arch": "x64"}': "@goldfish_build//platforms:linux_x64",
        '{"os": "macos", "arch": "x64"}': "@goldfish_build//platforms:macos_x64",
        '{"os": "macos", "arch": "arm64"}': "@goldfish_build//platforms:macos_aarch64",
        '{"os": "windows", "arch": "x64"}': "@goldfish_build//platforms:windows_x64",
    },
)
