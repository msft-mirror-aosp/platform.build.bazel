dav1d_srcs = [
    "src/cdf.c",
    "src/cpu.c",
    "src/ctx.c",
    "src/data.c",
    "src/decode.c",
    "src/dequant_tables.c",
    "src/getbits.c",
    "src/intra_edge.c",
    "src/itx_1d.c",
    "src/lf_mask.c",
    "src/lib.c",
    "src/log.c",
    "src/mem.c",
    "src/msac.c",
    "src/obu.c",
    "src/pal.c",
    "src/picture.c",
    "src/qm.c",
    "src/ref.c",
    "src/refmvs.c",
    "src/scan.c",
    "src/tables.c",
    "src/thread_task.c",
    "src/warpmv.c",
    "src/wedge.c",
] + select({
    ":cpu_aarch64": arm_dav1d_srcs + arm64_asm_srcs,
    ":cpu_armv7": arm_dav1d_srcs + armv7_asm_srcs,
    ":cpu_x86_32": x86_dav1d_srcs,
    ":cpu_x86_64": x86_dav1d_srcs,
    "//conditions:default": [],
}) + select({
    ":os_windows": ["src/win32/thread.c"],
    "//conditions:default": [],
})

nasm_library(
    name = "x86_asm",
    srcs = x86_asm_srcs,
    hdrs = [
        "src/ext/x86/x86inc.asm",
        "src/x86/filmgrain_common.asm",
    ] + select({
        ":macos_x86_64": ["config/apple/x64/config.asm"],
        ":windows_x86_64": ["config/win/x64/config.asm"],
        ":linux_x86_32": ["config/linux/x86/config.asm"],
        "//conditions:default": ["config/linux/x64/config.asm"],
    }),
    copts = select({
        ":macos_x86_64": [
            "-f",
            "macho64",
            "-DPIC",
        ],
        ":windows_x86_64": [
            "-f",
            "win64",
            "-DPIC",
        ],
        ":linux_x86_32": [
            "-f",
            "elf32",
            "-DPIC",
        ],
        "//conditions:default": [
            "-f",
            "elf64",
            "-DPIC",
        ],
    }),
    includes = [
        ".",
        "src",
    ] + select({
        ":macos_x86_64": ["config/apple/x64"],
        ":windows_x86_64": ["config/win/x64"],
        ":linux_x86_32": ["config/linux/x86"],
        "//conditions:default": ["config/linux/x64"],
    }),
    target_compatible_with = [
        "@platforms//cpu:x86_64",
    ],
)

shared_copts = [
    "-D_FILE_OFFSET_BITS=64",
    "-D_ISOC99_SOURCE",
    "-Wall",
    "-Winvalid-pch",
    "-Wextra",
    "-std=c99",
    "-I.",
    "-Ilibdav1d",
    "-Iinclude",
    "-Iinclude/dav1d",
    "-Iversion",
    "-Wundef",
    "-Wno-unused-parameter",
    "-Wno-undef",
    "-Wno-frame-larger-than",
    "-fomit-frame-pointer",
    "-ffast-math",
    "-fvisibility=hidden",
] + select({
    ":os_windows": [],
    "//conditions:default": ["-fPIC"],
}) + select({
    ":macos_x86_64": ["-Iconfig/apple/x64"],
    ":macos_aarch64": ["-Iconfig/apple/arm64"],
    ":windows_x86_64": ["-Iconfig/win/x64"],
    ":windows_aarch64": ["-Iconfig/win/arm64"],
    ":linux_x86_32": [
        "-D_GNU_SOURCE",
        "-Iconfig/linux/x86",
    ],
    ":linux_aarch64": [
        "-D_GNU_SOURCE",
        "-Iconfig/linux/arm64",
    ],
    ":linux_armv7": [
        "-D_GNU_SOURCE",
        "-Iconfig/linux/arm",
    ],
    "//conditions:default": [
        "-D_GNU_SOURCE",
        "-Iconfig/linux/x64",
    ],
})

