cc_library(
    name = "dav1d_hdrs",
    hdrs = common_hdrs + select({
        ":macos_x86_64": ["config/apple/x64/config.h"] + x86_hdrs,
        ":macos_aarch64": ["config/apple/arm64/config.h"] + arm_hdrs,
        ":windows_x86_64": ["config/win/x64/config.h"] + x86_hdrs,
        ":windows_aarch64": ["config/win/arm64/config.h"] + arm_hdrs,
        ":linux_x86_32": ["config/linux/x86/config.h"] + x86_hdrs,
        ":linux_aarch64": ["config/linux/arm64/config.h"] + arm_hdrs,
        ":linux_armv7": ["config/linux/arm/config.h"] + arm_hdrs,
        "//conditions:default": ["config/linux/x64/config.h"] + x86_hdrs,
    }) + select({
        ":cpu_armv7": arm32_tmpl_hdrs,
        ":cpu_aarch64": arm64_tmpl_hdrs,
        "//conditions:default": [],
    }),
    includes = [
        ".",
        "include",
        "include/dav1d",
        "version",
    ] + select({
        ":macos_x86_64": ["config/apple/x64"],
        ":macos_aarch64": ["config/apple/arm64"],
        ":windows_x86_64": ["config/win/x64"],
        ":windows_aarch64": ["config/win/arm64"],
        ":linux_x86_32": ["config/linux/x86"],
        ":linux_aarch64": ["config/linux/arm64"],
        ":linux_armv7": ["config/linux/arm"],
        "//conditions:default": ["config/linux/x64"],
    }),
    linkstatic = 1,
)

cc_library(
    name = "dav1d_lib_8bit",
    srcs = tmpl_srcs,
    copts = shared_copts + [
        "-DBITDEPTH=8",
    ],
    linkstatic = 1,
    deps = [
        ":dav1d_hdrs",
    ],
    alwayslink = 1,
)

cc_library(
    name = "dav1d_lib_16bit",
    srcs = tmpl_srcs,
    copts = shared_copts + [
        "-DBITDEPTH=16",
    ],
    linkstatic = 1,
    deps = [
        ":dav1d_hdrs",
    ],
    alwayslink = 1,
)

cc_library(
    name = "dav1d_lib",
    srcs = dav1d_srcs + select({
        ":cpu_x86_32": [":x86_asm"],
        ":cpu_x86_64": [":x86_asm"],
        "//conditions:default": [],
    }),
    hdrs = [
        "include/dav1d/common.h",
        "include/dav1d/data.h",
        "include/dav1d/dav1d.h",
        "include/dav1d/headers.h",
        "include/dav1d/picture.h",
        "include/dav1d/version.h",
    ],
    copts = shared_copts,
    linkopts = select({
        ":os_macos": [],
        ":os_windows": [],
        "//conditions:default": [
            "-ldl",
            "-pthread",
        ],
    }),
    linkstatic = 1,
    visibility = ["//visibility:public"],
    deps = [
        ":dav1d_hdrs",
        ":dav1d_lib_16bit",
        ":dav1d_lib_8bit",
    ],
    alwayslink = 1,
)

[
    cc_test(
        name = "header_test_{}".format(hdr.replace(".h", "")),
        srcs = ["tests/header_test.c"],
        copts = shared_copts + [
            '-DDAV1D_TEST_HEADER=\\"dav1d/{}\\"'.format(hdr),
        ],
        deps = [":dav1d_lib"],
    )
    for hdr in [
        "common.h",
        "data.h",
        "dav1d.h",
        "headers.h",
        "picture.h",
        "version.h",
    ]
]
