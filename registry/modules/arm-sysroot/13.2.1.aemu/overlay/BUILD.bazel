#
# This BUILD file defines the components of the aarch64-none-linux-gnu sysroot
# for use with a Bazel C++ toolchain.
#
# It uses the `cc_toolchain_import` rule to package specific sets of files
# and paths (headers, libraries, linker scripts) from the sysroot. These
# targets are then consumed by the `cc_toolchain_config` rule (in your
# toolchain.BUILD file) to construct the actual compiler and linker command lines.
load("@goldfish_build//toolchains/cc:rules.bzl", "cc_toolchain_import", "sysroot")

package(default_visibility = ["//visibility:public"])

# This target provides the low-level GNU/GCC linker components.
# These are files required by the linker and compiler driver that are
# *not* part of the C library (libc) or C++ library (libstdc++).
cc_toolchain_import(
    name = "linker",

    # Provides the search path for the libraries below (e.g., libgcc.a).
    # This will be added to the linker command line as an -L flag.
    lib_search_paths = [
        "lib/gcc/aarch64-none-linux-gnu/13.2.1",
    ],

    # A list of files that must be available during linking.
    support_files = [
        # 1. The dynamic linker/loader. This is the "interpreter" for
        #    all dynamically linked executables on the target system.
        "aarch64-none-linux-gnu/libc/lib/ld-linux-aarch64.so.1",
    ] + glob([
        # 2. GCC-specific libraries and runtime objects.
        #    - *.a: Static libraries like libgcc.a (compiler support functions).
        #    - *.o: C Runtime (CRT) object files like crtbeginS.o and
        #           crtendS.o, which handle global constructor/destructor setup.
        "lib/gcc/aarch64-none-linux-gnu/13.2.1/**/*.a",
        "lib/gcc/aarch64-none-linux-gnu/13.2.1/**/*.o",
    ]),
)

# This target provides all components for the C++ Standard Library (libstdc++).
# It is separated to allow for fine-grained control over C vs. C++ support.
cc_toolchain_import(
    name = "libstdcxx",

    # 1. Dynamic Linking Files
    #    These .so (shared object) files are used when building
    #    dynamic executables or shared libraries.
    dynamic_mode_libs = [
        # The main libstdc++ shared library.
        "aarch64-none-linux-gnu/lib64/libstdc++.so",
        # libgcc_s.so provides runtime support for exception handling
        # and other low-level features for *shared* libraries.
        "aarch64-none-linux-gnu/lib64/libgcc_s.so",
    ],

    # 3. C++ Header Paths
    #    These are the include paths for all C++ standard headers (e.g.,
    #    <vector>, <string>, <iostream>). They are critical because the
    #    toolchain is likely configured with -nostdinc++ (which disables
    #    the compiler's built-in C++ header search).
    include_paths = [
        "aarch64-none-linux-gnu/include/c++/13.2.1",
        "aarch64-none-linux-gnu/include/c++/13.2.1/aarch64-none-linux-gnu",
        "aarch64-none-linux-gnu/include/c++/13.2.1/backward",
    ],

    # 2. Static Linking Files
    #    These .a (archive) files are used when building static executables.
    static_mode_libs = [
        # The static libstdc++ archive.
        "aarch64-none-linux-gnu/lib64/libstdc++.a",
        # libgcc.a provides runtime support for *static* builds.
        "lib/gcc/aarch64-none-linux-gnu/13.2.1/libgcc.a",
        # Static exception handling support.
        "lib/gcc/aarch64-none-linux-gnu/13.2.1/libgcc_eh.a",
    ],

    # 4. Support Files
    #    This glob ensures that all C++ header files are actually included
    #    as inputs in the Bazel sandbox, so the compiler can find them at
    #    the paths specified in `include_paths`.
    support_files = glob([
        "aarch64-none-linux-gnu/include/c++/**",
    ]),
)

# This target provides all components for the C Standard Library (libc).
cc_toolchain_import(
    name = "libs",

    # 1. C Header Paths
    #    These are the include paths for all C standard headers
    #    (e.g., <stdio.h>, <stdlib.h>, <unistd.h>).
    include_paths = [
        # GCC-specific C headers (like stddef.h, limits.h)
        "aarch64-none-linux-gnu/include",
        # The main C library headers
        "aarch64-none-linux-gnu/libc/usr/include",
    ],

    # 2. C Library Search Paths
    #    These paths are added to the linker command with -L. The linker
    #    will search these directories to find libraries requested with -l
    #    (e.g., -lm for libm.so, -lpthread for libpthread.so).
    lib_search_paths = [
        "aarch64-none-linux-gnu/libc/lib64",
        "aarch64-none-linux-gnu/libc/usr/lib64",
        "aarch64-none-linux-gnu/libc/usr/lib",
        "lib/gcc/aarch64-none-linux-gnu/13.2.1",
    ],

    # 3. Dependencies
    #    This is a crucial line. It ensures that any target that depends
    #    on `libs` (the C library) *also* implicitly gets all the files
    #    and paths from the `linker` target (libgcc.a, crt*.o files).
    #    This is what bundles the low-level GCC runtime with the C library.
    deps = [":linker"],
)

sysroot(
    name = "arm_sysroot",
    # This glob includes *only* the libc-related files.
    all_files = glob(["aarch64-none-linux-gnu/libc/**"]),
    path = "aarch64-none-linux-gnu/libc",
)
