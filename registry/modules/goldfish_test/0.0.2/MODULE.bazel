    url = "gs://emu-next-bazel/test_seq/test_seq_20260205_1307_RC00/test_seq_darwin_arm64.zip",
)
test_seq_ext.windows(
    sha256 = "29c892cb076ec16c66c0bd70f6f4eea99fd68c3127afc9c1e11098fc1bf23736",
    url = "gs://emu-next-bazel/test_seq/test_seq_20260205_1307_RC00/test_seq_windows.zip",
