From 233b9c82f9b79cbc16360ae90142122621c62139 Mon Sep 17 00:00:00 2001
From: Kenneth Magic <kmagic@google.com>
Date: Wed, 21 Jan 2026 12:59:17 -0800
Subject: [PATCH] support multiple os paths

---
 rules/android_sdk_repository/rule.bzl | 20 ++++++++++++++------
 1 file changed, 14 insertions(+), 6 deletions(-)

diff --git a/rules/android_sdk_repository/rule.bzl b/rules/android_sdk_repository/rule.bzl
index fe82242..d62476e 100644
--- a/rules/android_sdk_repository/rule.bzl
+++ b/rules/android_sdk_repository/rule.bzl
@@ -92,7 +92,13 @@ def _find_system_images(repo_ctx, android_sdk_path):
 
 def _android_sdk_repository_impl(repo_ctx):
     # Determine the SDK path to use, either from the attribute or the environment.
-    android_sdk_path = repo_ctx.attr.path
+    android_sdk_path = None
+    if "linux" in repo_ctx.os.name:
+      android_sdk_path = repo_ctx.attr.paths.get("linux")
+    elif "mac" in repo_ctx.os.name:
+      android_sdk_path = repo_ctx.attr.paths.get("macos")
+    elif "windows" in repo_ctx.os.name:
+      android_sdk_path = repo_ctx.attr.paths.get("windows")
     if not android_sdk_path:
         android_sdk_path = repo_ctx.os.environ.get("ANDROID_HOME")
     if not android_sdk_path:
@@ -169,7 +175,7 @@ _android_sdk_repository = repository_rule(
     attrs = {
         "api_level": attr.int(default = 0),
         "build_tools_version": attr.string(),
-        "path": attr.string(),
+        "paths": attr.string_dict(),
     },
     environ = ["ANDROID_HOME"],
     local = True,
@@ -177,7 +183,7 @@ _android_sdk_repository = repository_rule(
 
 def android_sdk_repository(
         name,
-        path = "",
+        paths = "",
         api_level = 0,
         build_tools_version = ""):
     """Create a repository with Android SDK toolchains.
@@ -194,7 +200,7 @@ def android_sdk_repository(
 
     _android_sdk_repository(
         name = name,
-        path = path,
+        paths = paths,
         api_level = api_level,
         build_tools_version = build_tools_version,
     )
@@ -216,18 +222,20 @@ def _android_sdk_repository_extension_impl(module_ctx):
     if module.tags.configure:
         kwargs["api_level"] = module.tags.configure[0].api_level
         kwargs["build_tools_version"] = module.tags.configure[0].build_tools_version
-        kwargs["path"] = module.tags.configure[0].path
+        kwargs["paths"] = module.tags.configure[0].paths
 
     _android_sdk_repository(
         name = "androidsdk",
         **kwargs
     )
+    return module_ctx.extension_metadata(reproducible = True)
 
 android_sdk_repository_extension = module_extension(
     implementation = _android_sdk_repository_extension_impl,
+    os_dependent = True,
     tag_classes = {
         "configure": tag_class(attrs = {
-            "path": attr.string(),
+            "paths": attr.string_dict(),
             "api_level": attr.int(),
             "build_tools_version": attr.string(),
         }),
-- 
