+static void SetFiTimeFromUnixTime(CFiTime &fiTime, UInt32 unixTime)
+{
+#ifdef _WIN32
+  NWindows::NTime::UnixTime_To_FileTime(unixTime, fiTime);
+#else
+  fiTime.tv_sec = (time_t)unixTime;
+  fiTime.tv_nsec = 0;
+#endif
+}
+
+static bool ParseOctalMode(const wchar_t *s, unsigned len, UInt32 &val)
+{
+  if (len == 0 || len > 6)
+    return false;
+  UInt32 res = 0;
+  for (unsigned i = 0; i < len; i++)
+  {
+    wchar_t c = s[i];
+    if (c < L'0' || c > L'7')
+      return false;
+    res = (res << 3) | (UInt32)(c - L'0');
+  }
+  val = res;
+  return true;
+}
