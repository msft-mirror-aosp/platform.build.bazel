# On Windows we package some DLLs in the release zip..
custom_toolchains = use_extension("@goldfish_build//extensions:toolchain.bzl", "toolchain")
use_repo(custom_toolchains, "vctools", "windows_sdk")

# For studio_stats.proto
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

new_local_repository(
    name = "studio_stats",
    build_file = "//:studio_stats.BUILD",
    #overlay_files = {"BUILD.bazel": "//:studio_stats.BUILD"},
    path = "tools/analytics-library/protos/src/main/proto",
)

android_sdk = use_extension("@goldfish_build//extensions:android_sdk.bzl", "android_sdk")
use_repo(android_sdk, "sdk_linux", "sdk_macosx", "sdk_windows")

