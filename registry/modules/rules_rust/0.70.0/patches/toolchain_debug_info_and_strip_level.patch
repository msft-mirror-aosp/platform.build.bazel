+def _get_mode_opts_for_triple(opts, target_triple):
+    """Infer toolchain-specific mode options (dict of mode->val or dict of triple->(dict of mode->val))."""
+    if not opts:
+        return None
+    if target_triple in opts:
+        return opts[target_triple]
+    for v in opts.values():
+        if type(v) == "dict":
+            return None
+    return dict(opts)
