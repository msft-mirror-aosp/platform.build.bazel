cc_library(
    name = "gnulib",
    srcs = [
        "gnulib/arg-nonnull.h",
        "gnulib/asnprintf.c",
        "gnulib/c++defs.h",
        "gnulib/float+.h",
        "gnulib/fpucw.h",
        "gnulib/g-gnulib.h",
        "gnulib/isnan.c",
        "gnulib/isnand-nolibm.h",
        "gnulib/isnanl-nolibm.h",
        "gnulib/printf.c",
        "gnulib/printf.h",
        "gnulib/printf-args.c",
        "gnulib/printf-args.h",
        "gnulib/printf-frexp.c",
        "gnulib/printf-frexpl.c",
        "gnulib/printf-frexpl.h",
        "gnulib/printf-parse.c",
        "gnulib/printf-parse.h",
        "gnulib/vasnprintf.c",
        "gnulib/vasnprintf.h",
        "gnulib/verify.h",
        "gnulib/xsize.c",
        "gnulib/xsize.h",
    ] + PUBLIC_HDRS + INTERNAL_HDRS + PUBLIC_HDRS_WIN32,
    hdrs = [
        "gnulib/printf-frexp.c",
        "gnulib/printf-frexp.h",
        ":glib-visibility_h",
        ":glibconfig_h",
        ":gversionmacros_h",
    ] + [
        ":public_hdr_" + hdr.replace("/", "_")
        for hdr in PUBLIC_HDRS_WIN32
    ],
    copts = [
        "-I" + INCLUDE_PREFIX,
        "-I%s/glib" % (INCLUDE_PREFIX,),
        "-I%s/glibeprecated" % (INCLUDE_PREFIX,),
        "-Werror=implicit-function-declaration",
    ],
    includes = [
        "gnulib",
        "include_glib-2.0",
    ],
    local_defines = [
        "_GNU_SOURCE",
        "G_DISABLE_CAST_CHECKS",
        "GCC_LINT=1",
        "GLIB_COMPILATION",
        "HAVE_ISNAN_IN_LIBC",
        "HAVE_ISNAND_IN_LIBC",
        "HAVE_ISNANF_IN_LIBC",
        "HAVE_ISNANL_IN_LIBC",
    ],
    visibility = ["//visibility:public"],
