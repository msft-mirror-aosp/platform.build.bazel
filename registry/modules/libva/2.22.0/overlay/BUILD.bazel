load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Public headers target for consumers (e.g. videobridge) using dlopen at runtime
cc_library(
    name = "headers",
    hdrs = [
        "va/drm/va_drm.h",
        "va/va.h",
        "va/va_android.h",
        "va/va_backend.h",
        "va/va_backend_prot.h",
        "va/va_backend_vpp.h",
        "va/va_compat.h",
        "va/va_dec_av1.h",
        "va/va_dec_hevc.h",
        "va/va_dec_jpeg.h",
        "va/va_dec_vp8.h",
        "va/va_dec_vp9.h",
        "va/va_dec_vvc.h",
        "va/va_drm.h",
        "va/va_drmcommon.h",
        "va/va_egl.h",
        "va/va_enc_av1.h",
        "va/va_enc_h264.h",
        "va/va_enc_hevc.h",
        "va/va_enc_jpeg.h",
        "va/va_enc_mpeg2.h",
        "va/va_enc_vp8.h",
        "va/va_enc_vp9.h",
        "va/va_fei.h",
        "va/va_fei_h264.h",
        "va/va_fei_hevc.h",
        "va/va_prot.h",
        "va/va_str.h",
        "va/va_tpi.h",
        "va/va_version.h",
        "va/va_vpp.h",
        "va/va_x11.h",
    ],
    includes = [
        ".",
        "va",
    ],
)

# Core libva library
cc_library(
    name = "va",
    srcs = [
        "va/sysdeps.h",
        "va/va.c",
        "va/va_internal.h",
        "va/va_str.c",
        "va/va_trace.c",
        "va/va_trace.h",
    ],
    hdrs = [
        "va/va.h",
        "va/va_android.h",
        "va/va_backend.h",
        "va/va_backend_prot.h",
        "va/va_backend_vpp.h",
        "va/va_compat.h",
        "va/va_dec_av1.h",
        "va/va_dec_hevc.h",
        "va/va_dec_jpeg.h",
        "va/va_dec_vp8.h",
        "va/va_dec_vp9.h",
        "va/va_dec_vvc.h",
        "va/va_drmcommon.h",
        "va/va_egl.h",
        "va/va_enc_av1.h",
        "va/va_enc_h264.h",
        "va/va_enc_hevc.h",
        "va/va_enc_jpeg.h",
        "va/va_enc_mpeg2.h",
        "va/va_enc_vp8.h",
        "va/va_enc_vp9.h",
        "va/va_fei.h",
        "va/va_fei_h264.h",
        "va/va_fei_hevc.h",
        "va/va_prot.h",
        "va/va_str.h",
        "va/va_tpi.h",
        "va/va_version.h",
        "va/va_vpp.h",
        "va/va_x11.h",
    ],
    includes = [
        ".",
        "va",
    ],
    linkopts = select({
        "@platforms//os:linux": [
            "-ldl",
            "-lpthread",
        ],
        "//conditions:default": [],
    }),
    local_defines = [
        "SYSCONFDIR=\\\"/etc\\\"",
        "VA_DRIVERS_PATH=\\\"/usr/lib/x86_64-linux-gnu/dri:/usr/lib/dri\\\"",
        "HAVE_SECURE_GETENV=1",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:android": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

# libva-drm interface for DRM render nodes (/dev/dri/renderD128)
cc_library(
    name = "va_drm",
    srcs = [
        "va/drm/va_drm.c",
        "va/drm/va_drm_auth.c",
        "va/drm/va_drm_auth.h",
        "va/drm/va_drm_auth_x11.h",
        "va/drm/va_drm_utils.c",
        "va/drm/va_drm_utils.h",
    ],
    hdrs = [
        "va/drm/va_drm.h",
        "va/va_drm.h",
        "va/va_drmcommon.h",
    ],
    copts = [
        "-Iexternal/libva+/va",
        "-Iexternal/libva+/va/drm",
        "-Iexternal/libva+",
    ],
    includes = [
        ".",
        "va",
        "va/drm",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:android": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":va",
        "@libdrm//:drm",
    ],
)
